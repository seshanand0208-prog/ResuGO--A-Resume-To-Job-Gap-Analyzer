# GEMINI_API_KEY: Required for server-side Gemini/Gemma AI parsing, gap analysis, name analysis, and chatbot.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ENCRYPTION_KEY: 32-char secret used for AES-256-GCM encryption of resumes at rest & httpOnly session signing.
ENCRYPTION_KEY="change-this-to-a-strong-32-char-secret"

# Google reCAPTCHA v3 & v2 (optional — accessible human challenge fallback runs automatically when unset)
VITE_RECAPTCHA_V3_SITE_KEY=""
VITE_RECAPTCHA_V2_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Optional Live Google Jobs & Market Data APIs (falls back to Gemini Search Grounding when omitted)
SERPAPI_KEY=""
GOOGLE_CSE_API_KEY=""
GOOGLE_CSE_CX=""

# Optional Email Job Alerts provider (e.g. Resend API key)
RESEND_API_KEY=""

# Cloud SQL (PostgreSQL) Runtime Variables (auto-injected in AI Studio Cloud Run runtime)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
